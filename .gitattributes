# Auto detect text files and perform LF normalization
* text=auto

# Force LF for all text files
*.dart text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.kt text eol=lf
*.swift text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.mdc text eol=lf
*.toml text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.plist text eol=lf
*.xcconfig text eol=lf
*.pbxproj text eol=lf
*.xcscheme text eol=lf
*.xcsettings text eol=lf
*.xcworkspacedata text eol=lf
*.xib text eol=lf
*.storyboard text eol=lf
*.entitlements text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.rc text eol=lf
*.manifest text eol=lf
*.cmake text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

