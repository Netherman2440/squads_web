{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Flutter Web (Chrome) – app",
        "type": "dart",
        "request": "launch",
        "cwd": "${workspaceFolder}/app",
        "program": "lib/main.dart",
        "deviceId": "chrome",
        "toolArgs": [
          "--dart-define-from-file=.env"
        ]
      }
    ]
  }